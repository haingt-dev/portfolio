---
import { STUDIO } from '../data/site';
---

<header class="site-nav">
  <nav class="container nav-inner" aria-label="Main">
    <a href="/" class="wordmark" aria-label="haingt.dev">haingt<span>.dev</span></a>
    <a href={STUDIO.url} class="studio-link" rel="noopener">
      {STUDIO.name} <span class="ext" aria-hidden="true">↗</span>
    </a>
  </nav>
</header>

<style>
  .nav-inner {
    display: flex;
    align-items: center;
    gap: 2rem;
    height: 3.5rem;
  }

  .wordmark {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.15rem;
    letter-spacing: -0.01em;
    margin-right: auto;
  }

  .wordmark span { color: var(--color-muted); font-weight: 400; }

  .studio-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    padding: 0.4em 0.85em;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    font-size: 0.85rem;
    font-weight: 500;
    transition: border-color 0.2s, color 0.2s;
  }

  .studio-link:hover { border-color: var(--color-accent); color: var(--color-accent); }
  .ext { font-size: 0.85em; transition: transform 0.2s ease-out; }
  .studio-link:hover .ext { transform: translate(2px, -2px); }
</style>
